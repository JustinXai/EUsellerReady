# Environment variables for deploy.sh
# Copy this file to deploy.env and fill in your values.
# DO NOT commit deploy.env or any file containing real tokens to Git.

# =============================================================================
# GitHub Integration
# =============================================================================

# GitHub Personal Access Token (PAT) with:
#   - Actions: read/write  (required for workflow_dispatch)
#   - Contents: read      (optional, for higher API rate limits)
#   - Metadata: read       (always included)
#
# IMPORTANT: Never commit this file or any file containing a real token to Git.
# Keep this file only on the server at /opt/eureadyseller/deploy.env
# Create it with: sudo nano /opt/eureadyseller/deploy.env
GITHUB_TOKEN=

# Repository slug (default: JustinXai/EUsellerReady)
GITHUB_REPOSITORY=JustinXai/EUsellerReady

# Workflow name to watch for Quality Gate (must match .github/workflows/xxx.yml name field)
GITHUB_CI_WORKFLOW_NAME=EUReadySeller Quality Gate

# Workflow file name for GitHub-hosted external smoke
GITHUB_EXTERNAL_SMOKE_WORKFLOW=external-smoke.yml

# =============================================================================
# Site Configuration
# =============================================================================

# Live site URL (used as input for external smoke workflow)
SITE_URL=https://eureadyseller.com
