{
  "name": "eureadyseller",
  "type": "module",
  "version": "0.1.0",
  "description": "EUReadySeller - EU Compliance Guidance for Ecommerce Sellers",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:sitemap && npm run generate:robots && npm run generate:llms && astro build",
    "preview": "astro preview",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:claims": "node scripts/validate-claims.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:schema": "node scripts/validate-schema.mjs",
    "validate:robots": "node scripts/validate-robots.mjs",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "page:create": "node scripts/create-page-from-roadmap.mjs",
    "validate:page-template": "node scripts/validate-page-template.mjs",
    "validate:no-hardcoded-pages": "node scripts/validate-no-hardcoded-pages.mjs",
    "validate:official-sources": "node scripts/validate-official-sources.mjs",
    "validate:content-roadmap": "node scripts/validate-content-roadmap.mjs",
    "report": "node scripts/build-report.mjs",
    "verify": "npm run build && npm run validate:routes && npm run validate:seo && npm run validate:claims && npm run validate:links && npm run validate:schema && npm run validate:robots && npm run validate:content-roadmap && npm run validate:page-template && npm run validate:official-sources && npm run validate:no-hardcoded-pages && npm run validate:artifacts && npm run report",
    "external:smoke": "node scripts/external-smoke.mjs",
    "ci:wait": "node scripts/wait-github-ci.mjs",
    "ci:external": "node scripts/trigger-github-external-smoke.mjs",
    "live:grep": "node scripts/live-grep-check.mjs"
  },
  "dependencies": {
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
