---
const disclaimer = 'EUReadySeller provides educational information and scoping tools for ecommerce sellers. It does not provide legal advice and does not determine whether your products, store, or business are compliant. Always consult qualified legal counsel or a compliance provider for your specific situation.';
---

<aside class="disclaimer-block" aria-label="Disclaimer">
  <div class="disclaimer-inner">
    <div class="disclaimer-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M9 8.25v5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        <circle cx="9" cy="6" r="0.75" fill="currentColor"/>
      </svg>
    </div>
    <div class="disclaimer-content">
      <div class="disclaimer-label-row">
        <strong class="disclaimer-label">Disclaimer</strong>
      </div>
      <p class="disclaimer-text">{disclaimer}</p>
    </div>
  </div>
</aside>

<style>
  .disclaimer-block {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-6);
    margin: var(--space-8) 0;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-xs);
  }

  .disclaimer-block::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-warning);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .disclaimer-inner {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .disclaimer-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-warning-surface);
    border: 1px solid #fde68a;
    border-radius: var(--radius-md);
    color: var(--color-warning);
    margin-top: 0.05rem;
  }

  .disclaimer-content {
    flex: 1;
  }

  .disclaimer-label-row {
    margin-bottom: var(--space-2);
  }

  .disclaimer-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-warning);
  }

  .disclaimer-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
