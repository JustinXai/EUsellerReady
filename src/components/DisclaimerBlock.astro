---
const disclaimer = 'EUReadySeller provides educational information and scoping tools for ecommerce sellers. It does not provide legal advice and does not determine whether your products, store, or business are compliant. Always consult qualified legal counsel or a compliance provider for your specific situation.';
---

<aside class="disclaimer-block" aria-label="Disclaimer">
  <div class="disclaimer-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
  </div>
  <div class="disclaimer-content">
    <strong class="disclaimer-label">Disclaimer</strong>
    <p>{disclaimer}</p>
  </div>
</aside>

<style>
  .disclaimer-block {
    background: #fefce8;
    border: 1px solid #fde047;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .disclaimer-icon {
    flex-shrink: 0;
    color: #ca8a04;
    margin-top: 0.1rem;
  }

  .disclaimer-content {
    font-size: 0.875rem;
    color: #713f12;
    line-height: 1.6;
  }

  .disclaimer-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ca8a04;
    margin-bottom: 0.25rem;
  }

  .disclaimer-content p {
    margin: 0;
  }
</style>
