---
import type { FAQItem } from '../data/faq';

export interface Props {
  faqs: FAQItem[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="faq-block">
  <div class="faq-header">
    <div class="section-label">
      <span class="section-label-dot"></span>
      FAQ
    </div>
    <h2 class="faq-heading">{heading}</h2>
  </div>
  <div class="faq-list">
    {faqs.map((faq, index) => (
      <details class="faq-item" name="faq">
        <summary class="faq-question">
          <span class="faq-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="faq-q-text">{faq.question}</span>
          <span class="faq-chevron" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.5 6.75l4.5 4.5 4.5-4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-block {
    margin: var(--space-12) 0;
  }

  .faq-header {
    margin-bottom: var(--space-6);
  }

  .faq-heading {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: var(--space-3);
    letter-spacing: var(--tracking-tight);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .faq-item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-border-strong);
  }

  .faq-item[open] {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text-main);
    list-style: none;
    line-height: var(--leading-snug);
    transition: background var(--transition-fast);
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::marker { display: none; }

  .faq-item[open] .faq-question {
    color: var(--color-primary);
    background: var(--color-primary-surface);
  }

  .faq-question:hover {
    background: var(--color-bg-soft);
  }

  .faq-item[open] .faq-question:hover {
    background: var(--color-primary-surface);
  }

  .faq-num {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    min-width: 1.75rem;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .faq-item[open] .faq-num {
    opacity: 1;
  }

  .faq-q-text {
    flex: 1;
    text-align: left;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    transition: transform var(--transition-base), color var(--transition-fast);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-answer {
    padding: var(--space-1) var(--space-6) var(--space-6);
    padding-left: calc(var(--space-6) + 1.75rem + var(--space-4));
  }

  .faq-answer p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 600px) {
    .faq-question {
      padding: var(--space-4) var(--space-5);
      gap: var(--space-3);
      font-size: var(--text-sm);
    }

    .faq-answer {
      padding: var(--space-1) var(--space-5) var(--space-5);
      padding-left: var(--space-5);
    }
  }
</style>
