---
import { footerLinks } from '../data/navigation';
import { site } from '../data/site';
---

<footer class="site-footer">
  <!-- Main footer content -->
  <div class="footer-main">
    <div class="container footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="6" fill="#1d4ed8"/>
              <path d="M7 9h14M7 14h10M7 19h12" stroke="white" stroke-width="1.75" stroke-linecap="round"/>
              <circle cx="21" cy="19" r="3" fill="white" fill-opacity="0.9"/>
              <path d="M19.5 19l.8.8L21.5 18.2" stroke="#1d4ed8" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          EUReadySeller
        </a>
        <p class="footer-tagline">
          Educational EU compliance navigation for ecommerce sellers preparing to sell into Europe.
        </p>
        <p class="footer-disclaimer">
          {site.disclaimer}
        </p>
      </div>

      <!-- Link columns -->
      {footerLinks.map((section) => (
        <div class="footer-section">
          <h3 class="footer-heading">{section.heading}</h3>
          <ul class="footer-links">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>
  </div>

  <!-- Footer bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} EUReadySeller. All rights reserved.
      </p>
      <p class="footer-notice">
        Educational resource only &mdash; not legal advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.65);
    margin-top: auto;
  }

  /* Main grid */
  .footer-main {
    padding: var(--space-16) 0 var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-10);
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .footer-logo-icon {
    display: flex;
    align-items: center;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.55);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 280px;
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 280px;
  }

  /* Link sections */
  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color var(--transition-fast);
    line-height: var(--leading-normal);
  }

  .footer-link:hover {
    color: #ffffff;
    text-decoration: none;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-5) 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
    margin: 0;
  }

  .footer-notice {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.28);
    margin: 0;
    font-style: italic;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
