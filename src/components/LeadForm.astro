---
export interface Props {
  topic?: string;
}

const { topic = 'gpsr' } = Astro.props;
---

<div class="lead-form-container">
  <div class="form-notice">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <p>
      Form backend coming soon. For now, reach us at
      <a href="mailto:hello@eureadyseller.com">hello@eureadyseller.com</a>
    </p>
  </div>

  <form
    id="lead-form"
    class="lead-form"
    novalidate
    action="mailto:hello@eureadyseller.com"
    method="GET"
    enctype="text/plain"
  >
    <div class="form-row">
      <div class="form-group">
        <label for="lf-name" class="form-label">Name <span class="required" aria-hidden="true">*</span></label>
        <input type="text" id="lf-name" name="name" class="form-input" required autocomplete="name" placeholder="Your full name" />
      </div>
      <div class="form-group">
        <label for="lf-email" class="form-label">Email <span class="required" aria-hidden="true">*</span></label>
        <input type="email" id="lf-email" name="email" class="form-input" required autocomplete="email" placeholder="you@business.com" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="lf-location" class="form-label">Business location <span class="required" aria-hidden="true">*</span></label>
        <select id="lf-location" name="location" class="form-select" required>
          <option value="">Select country group</option>
          <option value="us">United States</option>
          <option value="uk">United Kingdom</option>
          <option value="china">China</option>
          <option value="canada">Canada</option>
          <option value="other-non-eu">Other non-EU country</option>
          <option value="eu">EU country</option>
        </select>
      </div>
      <div class="form-group">
        <label for="lf-platform" class="form-label">Store platform <span class="required" aria-hidden="true">*</span></label>
        <select id="lf-platform" name="platform" class="form-select" required>
          <option value="">Select platform</option>
          <option value="shopify">Shopify</option>
          <option value="amazon">Amazon</option>
          <option value="etsy">Etsy</option>
          <option value="woocommerce">WooCommerce</option>
          <option value="custom-store">Custom store</option>
          <option value="multiple-platforms">Multiple platforms</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="lf-products" class="form-label">Product category</label>
        <select id="lf-products" name="products" class="form-select">
          <option value="">Select category</option>
          <option value="general-goods">General goods</option>
          <option value="apparel">Apparel</option>
          <option value="electronics">Electronics</option>
          <option value="toys">Toys</option>
          <option value="cosmetics">Cosmetics</option>
          <option value="batteries">Batteries</option>
          <option value="home-goods">Home goods</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label for="lf-countries" class="form-label">Target EU countries</label>
        <select id="lf-countries" name="countries" class="form-select">
          <option value="">Select countries</option>
          <option value="germany">Germany</option>
          <option value="france">France</option>
          <option value="germany-france">Germany and France</option>
          <option value="multiple">Multiple EU countries</option>
          <option value="not-sure">Not sure yet</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <fieldset class="form-fieldset">
        <legend class="form-label">Topics needed <span class="required" aria-hidden="true">*</span></legend>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="topics" value="gpsr" />
            <span>GPSR</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="topics" value="eu-responsible-person" />
            <span>EU Responsible Person</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="topics" value="epr-packaging" />
            <span>EPR packaging</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="topics" value="not-sure" />
            <span>Not sure — need guidance</span>
          </label>
        </div>
      </fieldset>
    </div>

    <div class="form-group">
      <label for="lf-message" class="form-label">Message</label>
      <textarea
        id="lf-message"
        name="message"
        class="form-textarea"
        rows="4"
        placeholder="Describe your products, target markets, and what compliance help you need..."
      ></textarea>
    </div>

    <div class="form-submit">
      <button type="submit" class="form-button" id="submit-btn">
        Submit Quote Request
      </button>
      <p class="form-disclaimer">
        EUReadySeller does not provide legal advice. This form is for educational scoping and provider matching only.
      </p>
    </div>
  </form>
</div>

<style>
  .lead-form-container {
    max-width: 680px;
  }

  .form-notice {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #92400e;
  }

  .form-notice svg { flex-shrink: 0; margin-top: 0.1rem; }
  .form-notice p { margin: 0; }
  .form-notice a { color: #2563eb; }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }

  .required { color: #dc2626; }

  .form-input,
  .form-select,
  .form-textarea {
    padding: 0.625rem 0.875rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-family: inherit;
    color: #111827;
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
    box-sizing: border-box;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.375rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: #374151;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    accent-color: #2563eb;
  }

  .form-textarea { resize: vertical; min-height: 100px; }

  .form-submit {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .form-button {
    background: #2563eb;
    color: #ffffff;
    border: none;
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
    font-family: inherit;
  }

  .form-button:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  .form-disclaimer {
    font-size: 0.75rem;
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
  }
</style>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.textContent = 'Opening email client...';
      submitBtn.disabled = true;
    }
  });
</script>
