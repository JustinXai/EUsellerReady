---
import type { OfficialSource } from '../data/officialSources';

export interface Props {
  sources: OfficialSource[];
  heading?: string;
}

const { sources, heading = 'Official Sources' } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources-block">
    <div class="sources-header">
      <div class="section-label">
        <span class="section-label-dot"></span>
        References
      </div>
      <h2 class="sources-heading">{heading}</h2>
      <p class="sources-sub">Official and authoritative sources for compliance topics.</p>
    </div>
    <div class="sources-grid">
      {sources.map((source) => (
        <a
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
          class="source-card"
        >
          <div class="source-card-inner">
            <div class="source-card-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.5 2.5h6a1 1 0 011 1v8a1 1 0 01-1 1h-6a1 1 0 01-1-1v-8a1 1 0 011-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M4.5 2.5V1.5a1 1 0 011-1h5a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.5"/>
                <path d="M6 7l2 2-2 2M9 11h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="source-card-content">
              <span class="source-card-title">{source.title}</span>
              {source.description && (
                <p class="source-card-desc">{source.description}</p>
              )}
            </div>
            <div class="source-card-arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .sources-block {
    margin: var(--space-10) 0;
  }

  .sources-header {
    margin-bottom: var(--space-6);
  }

  .sources-heading {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .sources-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .sources-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .source-card {
    display: block;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-base);
  }

  .source-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateX(2px);
    text-decoration: none;
  }

  .source-card-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }

  .source-card-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-surface);
    border-radius: var(--radius-md);
    color: var(--color-primary);
  }

  .source-card-content {
    flex: 1;
    min-width: 0;
  }

  .source-card-title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
    line-height: var(--leading-snug);
  }

  .source-card:hover .source-card-title {
    color: var(--color-primary-dark);
  }

  .source-card-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }

  .source-card-arrow {
    flex-shrink: 0;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .source-card:hover .source-card-arrow {
    transform: translateX(2px);
    color: var(--color-primary);
  }
</style>
