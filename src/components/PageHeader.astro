---
export interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Page heading',
  subheading,
} = Astro.props;
---

<div class="page-header">
  <div class="page-header-bg" aria-hidden="true">
    <div class="page-header-gradient"></div>
  </div>
  <div class="page-header-inner container">
    <div class="page-header-content">
      <h1 class="page-h1">{heading}</h1>
      {subheading && <p class="page-subheading">{subheading}</p>}
    </div>
  </div>
</div>

<style>
  .page-header {
    position: relative;
    background: var(--color-bg-dark);
    padding: var(--space-12) 0;
    overflow: hidden;
  }

  .page-header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .page-header-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, #0f172a 0%, #1e3a5f 40%, #1d4ed8 80%, #2563eb 100%);
    opacity: 1;
  }

  .page-header-gradient::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(37, 99, 235, 0.2) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 20% 80%, rgba(15, 23, 42, 0.4) 0%, transparent 60%);
  }

  .page-header-inner {
    position: relative;
    z-index: 1;
  }

  .page-header-content {
    max-width: var(--container-content);
  }

  .page-h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-4);
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15);
  }

  .page-subheading {
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
    line-height: var(--leading-relaxed);
    max-width: 640px;
    font-weight: 400;
  }
</style>
