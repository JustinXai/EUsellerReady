---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AISummary from '../components/AISummary.astro';
import FAQBlock from '../components/FAQBlock.astro';
import DisclaimerBlock from '../components/DisclaimerBlock.astro';
import OfficialSources from '../components/OfficialSources.astro';
import CTABox from '../components/CTABox.astro';
import { site } from '../data/site';
import { routes } from '../data/routes';
import { euRpDecisionFAQs } from '../data/faq';
import { getSourcesForTopics } from '../data/officialSources';
import { buildWebPageSchema, buildFAQPageSchema } from '../lib/schema';

const pagePath = '/do-i-need-an-eu-responsible-person/';
const canonical = `${site.siteUrl}/do-i-need-an-eu-responsible-person/`;
const route = routes.find((r) => r.path === pagePath)!;

const jsonLd = [
  buildWebPageSchema(pagePath, route.title, route.description, route.h1),
  buildFAQPageSchema(euRpDecisionFAQs),
];

const sources = getSourcesForTopics(['gpsr', 'euResponsiblePerson']);

const decisionSteps = [
  {
    step: 1,
    question: 'Are you based outside the EU and selling physical products to EU consumers?',
    yes: 'You may need an EU Responsible Person under GPSR.',
    no: 'You may not need one for GPSR purposes. EU-based sellers typically do not require an EU Responsible Person under GPSR.',
  },
  {
    step: 2,
    question: 'Is your manufacturer based in the EU?',
    yes: 'Your manufacturer\'s EU presence may affect whether you need to appoint your own EU Responsible Person.',
    no: 'You may need to appoint an EU Responsible Person as a non-EU seller with non-EU manufacturing.',
  },
  {
    step: 3,
    question: 'Are you selling via Amazon, Shopify, Etsy or another platform to EU consumers?',
    yes: 'Platform requirements may add additional topics to review. Each platform may have its own responsible party field requirements.',
    no: 'Direct-to-consumer sales to EU consumers may still require EU Responsible Person topics to be addressed.',
  },
];

const factors = [
  {
    title: 'Business location',
    description: 'Whether your business is based inside or outside the EU is a key factor. Non-EU sellers typically need an EU Responsible Person.',
  },
  {
    title: 'Manufacturer location',
    description: 'Where your product manufacturer is based affects who may need to act as or appoint an EU Responsible Person.',
  },
  {
    title: 'Your role in the supply chain',
    description: 'Whether you are a seller, importer, distributor, or fulfill-by-order provider may affect your specific obligations.',
  },
  {
    title: 'Product type',
    description: 'Some product categories may have additional requirements beyond general GPSR topics.',
  },
  {
    title: 'Target EU markets',
    description: 'Specific EU countries may have additional product safety or labeling requirements to review.',
  },
  {
    title: 'Selling platform',
    description: 'Each platform may have its own fields and requirements for responsible party information. Platform interfaces may change.',
  },
];

const scenarios = [
  {
    title: 'Non-EU seller, products manufactured outside the EU',
    description: 'A US-based seller manufacturing products in China and selling to EU consumers on Amazon or Shopify likely needs an EU Responsible Person.',
  },
  {
    title: 'Non-EU seller, EU manufacturer',
    description: 'A UK seller using an EU-based manufacturer may have different obligations depending on their role and where they are established.',
  },
  {
    title: 'EU-based seller',
    description: 'An EU-based seller selling to EU consumers typically does not need an EU Responsible Person under GPSR, though they may have other product safety obligations.',
  },
  {
    title: 'FBA or MFN seller on Amazon',
    description: 'Amazon sellers using Fulfillment by Amazon (FBA) or Merchant Fulfilled Network (MFN) may need to review responsible party topics. Platform requirements may apply.',
  },
];

const mistakes = [
  'Assuming you do not need one based on your selling volume — GPSR may apply regardless of sales volume',
  'Assuming your platform exempts you from obligations — platform terms do not override regulatory requirements',
  'Not reviewing whether your manufacturer\'s EU presence affects your needs',
  'Forgetting that different product types may have different requirements',
  'Not reviewing current Amazon Seller Central or platform requirements as interfaces may change',
  'Confusing importer status with EU Responsible Person — these are distinct roles under GPSR',
];
---

<Layout
  title={route.title}
  description={route.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <PageHeader
    heading={route.h1}
    subheading="Learn when ecommerce sellers may need to review EU Responsible Person topics before selling physical products to EU consumers under GPSR."
  />

  <div class="prose-shell">
  <div class="content-wrapper">
    <div class="quick-answer">
      <p class="quick-answer-label">Quick Answer</p>
      <p>
        Non-EU ecommerce sellers selling physical products to EU consumers may need an EU Responsible Person under GPSR. The requirement depends on where your business and manufacturer are based, your role (seller, importer, or distributor), and the products you sell. Use this guide to review the key factors and scenarios.
      </p>
    </div>

    <AISummary summary={route.aiSummary} />

    <div class="decision-tree">
      <h2>Short decision tree</h2>
      {decisionSteps.map((step) => (
        <div class="decision-step">
          <div class="step-number">{step.step}</div>
          <div class="step-content">
            <p class="step-question">{step.question}</p>
            <div class="decision-answers">
              <div class="decision-yes">
                <strong>Yes:</strong> {step.yes}
              </div>
              <div class="decision-no">
                <strong>No:</strong> {step.no}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="content-block">
      <h2>Who does this apply to?</h2>
      <p>
        This guide is for ecommerce sellers — including Shopify, Amazon, Etsy, WooCommerce and DTC brands — who are preparing to sell physical products to consumers in the European Union and want to understand whether EU Responsible Person topics may apply to their situation.
      </p>

      <h2>Factors that may affect the answer</h2>
      <div class="factors-grid">
        {factors.map((factor) => (
          <div class="factor-card">
            <h3>{factor.title}</h3>
            <p>{factor.description}</p>
          </div>
        ))}
      </div>

      <h2>Example scenarios</h2>
      <div class="scenarios-list">
        {scenarios.map((scenario) => (
          <div class="scenario-item">
            <h3>{scenario.title}</h3>
            <p>{scenario.description}</p>
          </div>
        ))}
      </div>

      <h2>What sellers may need to prepare</h2>
      <ul class="checklist">
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Review where your business and manufacturer are based</span>
        </li>
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Determine whether you may need an EU Responsible Person</span>
        </li>
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Identify your role in the supply chain (seller, importer, distributor)</span>
        </li>
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Review product documentation and traceability records</span>
        </li>
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Prepare product safety information and documentation</span>
        </li>
        <li class="checklist-item">
          <span class="checklist-icon"></span>
          <span>Add EU Responsible Person details to platform listings where applicable</span>
        </li>
      </ul>

      <h2>Common mistakes to avoid</h2>
      <div class="mistakes-list">
        {mistakes.map((m) => (
          <div class="mistake-item">
            <svg class="mistake-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <p class="mistake-text">{m}</p>
          </div>
        ))}
      </div>

      <h2>Use the EU Seller Compliance Checker</h2>
      <p>
        If you want to identify which compliance topics may apply to your specific situation, use the free EU Seller Compliance Checker. It asks about your business location, platform, product type and target markets to suggest topics to review.
      </p>
    </div>
  </div>

  <div class="wide-shell">
    <OfficialSources sources={sources} />

    <FAQBlock faqs={euRpDecisionFAQs} />

    <DisclaimerBlock />

    <div class="cta-section">
      <h2>Identify your compliance topics</h2>
      <p>Use the free checker to see what may apply to your selling situation.</p>
      <div class="cta-section-buttons">
        <CTABox text={site.primaryCtaText} href={site.primaryCtaHref} variant="ghost" />
        <CTABox text={site.secondaryCtaText} href={site.secondaryCtaHref} variant="secondary" />
      </div>
    </div>

    <div class="related-guides">
      <h2>Related guides</h2>
      <ul>
        <li><a href="/gpsr-compliance-for-shopify/">GPSR Compliance for Shopify Sellers</a></li>
        <li><a href="/gpsr-compliance-for-amazon-sellers/">GPSR Compliance for Amazon Sellers</a></li>
        <li><a href="/gpsr-compliance-for-etsy-sellers/">GPSR Compliance for Etsy Sellers</a></li>
        <li><a href="/gpsr-product-safety-information-checklist/">GPSR Product Safety Information Checklist</a></li>
        <li><a href="/gpsr-general-guide/">GPSR General Guide</a></li>
        <li><a href="/eu-responsible-person-service/">EU Responsible Person Service</a></li>
        <li><a href="/request-eu-compliance-quotes/">Request EU Compliance Quotes</a></li>
      </ul>
    </div>
    </div>
</Layout>
