---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AISummary from '../components/AISummary.astro';
import FAQBlock from '../components/FAQBlock.astro';
import DisclaimerBlock from '../components/DisclaimerBlock.astro';
import OfficialSources from '../components/OfficialSources.astro';
import CTABox from '../components/CTABox.astro';
import { site } from '../data/site';
import { routes } from '../data/routes';
import { eprFAQs } from '../data/faq';
import { getSourcesForTopic } from '../data/officialSources';
import { buildWebPageSchema, buildFAQPageSchema } from '../lib/schema';

const pagePath = '/epr-compliance-for-shopify/';
const canonical = `${site.siteUrl}/epr-compliance-for-shopify/`;
const route = routes.find((r) => r.path === pagePath)!;

const jsonLd = [
  buildWebPageSchema(pagePath, route.title, route.description, route.h1),
  buildFAQPageSchema(eprFAQs),
];

const sources = getSourcesForTopic('epr');

const checklist = [
  'Identify which EU countries you sell physical products to',
  'Determine whether EPR packaging registration applies (Germany and France are most active)',
  'Register with the relevant national EPR scheme — LUCID for Germany',
  'Calculate estimated packaging volumes by material type',
  'Report packaging data to each EPR scheme periodically',
  'Pay applicable recycling contributions',
  'Retain EPR registration numbers for platform verification',
];

const mistakes = [
  'Assuming EPR only applies above a certain sales threshold — registration may be required regardless of volume',
  'Only registering in Germany but selling to France as well — France has its own EPR scheme',
  'Not reporting packaging data after registration — ongoing reporting is required',
  'Assuming Amazon\'s packaging compliance automatically covers your EPR obligations',
];
---

<Layout
  title={route.title}
  description={route.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <PageHeader
    heading={route.h1}
    subheading="A practical guide to EPR packaging topics Shopify sellers may need to review before selling physical products in EU markets."
  />

  <div class="content-wrapper">
    <div class="quick-answer">
      <p class="quick-answer-label">Quick Answer</p>
      <p>
        EPR (Extended Producer Responsibility) packaging regulations may apply to Shopify sellers shipping physical products in packaging to consumers in EU countries such as Germany and France. Sellers may need to register with country-specific packaging schemes, report packaging volumes and pay recycling contributions. Amazon and other platforms may verify EPR registration before allowing sales.
      </p>
    </div>

    <AISummary summary={route.aiSummary} />

    <div class="content-block">
      <h2>Who does EPR packaging apply to?</h2>
      <p>
        Sellers who ship physical products in packaging to consumers in EU countries may need to register for EPR packaging schemes. Germany and France have active EPR packaging regulations. If you sell on Shopify, Amazon, Etsy or WooCommerce to EU consumers, review whether EPR packaging applies to your situation.
      </p>

      <h2>EPR packaging checklist for Shopify sellers</h2>
      <ul class="checklist">
        {checklist.map((item) => (
          <li class="checklist-item">
            <span class="checklist-icon"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <h2>Common EPR mistakes for Shopify sellers</h2>
      <div class="mistakes-list">
        {mistakes.map((m) => (
          <div class="mistake-item">
            <svg class="mistake-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <p class="mistake-text">{m}</p>
          </div>
        ))}
      </div>

      <h2>Service options</h2>
      <p>
        EPR packaging compliance services are offered by specialized compliance providers who can handle registration, reporting and recycling fee management across multiple EU countries. Request quotes through EUReadySeller.
      </p>
    </div>

    <OfficialSources sources={sources} />

    <FAQBlock faqs={eprFAQs} />

    <DisclaimerBlock />

    <div class="cta-section">
      <h2>Prepare your EPR packaging compliance</h2>
      <p>Use the checker to identify whether EPR applies to your Shopify store.</p>
      <div class="cta-section-buttons">
        <CTABox text={site.primaryCtaText} href={site.primaryCtaHref} variant="ghost" />
        <CTABox text={site.secondaryCtaText} href={site.secondaryCtaHref} variant="secondary" />
      </div>
    </div>
  </div>
</Layout>
