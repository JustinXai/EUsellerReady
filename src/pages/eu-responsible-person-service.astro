---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AISummary from '../components/AISummary.astro';
import FAQBlock from '../components/FAQBlock.astro';
import DisclaimerBlock from '../components/DisclaimerBlock.astro';
import OfficialSources from '../components/OfficialSources.astro';
import CTABox from '../components/CTABox.astro';
import { site } from '../data/site';
import { routes } from '../data/routes';
import { euRpFAQs } from '../data/faq';
import { getSourcesForTopic } from '../data/officialSources';
import { buildWebPageSchema, buildFAQPageSchema } from '../lib/schema';

const pagePath = '/eu-responsible-person-service/';
const canonical = `${site.siteUrl}/eu-responsible-person-service/`;
const route = routes.find((r) => r.path === pagePath)!;

const jsonLd = [
  buildWebPageSchema(pagePath, route.title, route.description, route.h1),
  buildFAQPageSchema(euRpFAQs),
];

const sources = getSourcesForTopic('euResponsiblePerson');

const checklist = [
  'Confirm whether you need an EU Responsible Person (non-EU sellers typically do)',
  'Research and compare EU Responsible Person service providers',
  'Request quotes from providers through EUReadySeller',
  'Prepare product technical documentation package',
  'Share documentation with your appointed EU Responsible Person',
  'Add EU Responsible Person contact details to product packaging and listings',
  'Maintain ongoing communication with your EU Responsible Person',
];

const mistakes = [
  'Assuming EU-based sellers need an EU Responsible Person — EU-based sellers typically do not',
  'Using a generic EU contact without formal designation — the appointment must be documented',
  'Forgetting to update EU Responsible Person details when switching providers',
  'Not preparing product documentation before engaging a provider, causing delays',
];
---

<Layout
  title={route.title}
  description={route.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <PageHeader
    heading={route.h1}
    subheading="Understand what an EU Responsible Person is, when ecommerce sellers may need one, and what to prepare before requesting provider quotes."
  />

  <div class="content-wrapper">
    <div class="quick-answer">
      <p class="quick-answer-label">Quick Answer</p>
      <p>
        An EU Responsible Person is required under GPSR for non-EU sellers placing physical products on the EU market. If you are based outside the EU (US, UK, China, Canada, etc.) and sell physical products to EU consumers, you likely need an EU Responsible Person. EU-based sellers typically do not.
      </p>
    </div>

    <AISummary summary={route.aiSummary} />

    <div class="content-block">
      <h2>Who may need an EU Responsible Person?</h2>
      <p>
        Non-EU sellers shipping physical products to EU consumers typically need an EU Responsible Person under GPSR. EU-based manufacturers and sellers generally do not need one, as they can fulfil the obligations directly. Use the free compliance checker to scope your situation.
      </p>

      <h2>What to prepare before requesting quotes</h2>
      <ul class="checklist">
        {checklist.map((item) => (
          <li class="checklist-item">
            <span class="checklist-icon"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <h2>Common mistakes when selecting an EU Responsible Person</h2>
      <div class="mistakes-list">
        {mistakes.map((m) => (
          <div class="mistake-item">
            <svg class="mistake-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <p class="mistake-text">{m}</p>
          </div>
        ))}
      </div>

      <h2>Provider options</h2>
      <p>
        EU Responsible Person services are offered by compliance service providers, legal firms and specialized compliance platforms. For a broader view of compliance provider categories, see the <a href="/eu-compliance-provider-directory/">EU Compliance Provider Directory</a>.
      </p>
    </div>

    <OfficialSources sources={sources} />

    <FAQBlock faqs={euRpFAQs} />

    <DisclaimerBlock />

    <div class="cta-section">
      <h2>Request EU Responsible Person service quotes</h2>
      <p>Get in touch with qualified EU Responsible Person service providers.</p>
      <div class="cta-section-buttons">
        <CTABox text={site.secondaryCtaText} href={site.secondaryCtaHref} variant="ghost" />
        <CTABox text={site.primaryCtaText} href={site.primaryCtaHref} variant="secondary" />
      </div>
    </div>
  </div>
</Layout>
